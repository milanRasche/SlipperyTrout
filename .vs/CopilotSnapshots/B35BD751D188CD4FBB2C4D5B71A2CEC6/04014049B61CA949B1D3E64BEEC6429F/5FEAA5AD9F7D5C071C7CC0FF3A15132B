
using System;

namespace SlipperyTrout.Chess
{
    internal class MovePerformer
    {
        public void PerformMove(GameState gameState, Move move)
        {
            char piece = gameState.Board[move.FromRow, move.FromCol];
            char capturedPiece = gameState.Board[move.ToRow, move.ToCol];

            bool isWhiteMove = gameState.WhiteToMove;

            // Handle en passant
            bool isEnPassant =
                char.ToUpper(piece) == 'P' &&
                move.FromCol != move.ToCol &&
                capturedPiece == ' ';

            if (isEnPassant)
            {
                capturedPiece =
                    gameState.Board[move.FromRow, move.ToCol];

                gameState.Board[move.FromRow, move.ToCol] = ' ';
            }

            // Handle castling
            bool isCastling =
                char.ToUpper(piece) == 'K' &&
                Math.Abs(move.ToCol - move.FromCol) == 2;

            if (isCastling)
            {
                PerformCastling(gameState, move);
            }

            // Move the piece
            gameState.Board[move.ToRow, move.ToCol] = piece;
            gameState.Board[move.FromRow, move.FromCol] = ' ';

            // Handle pawn promotion
            if (char.ToUpper(piece) == 'P' &&
                (move.ToRow == 0 || move.ToRow == 7))
            {
                char promotion = move.Promotion == '\0'
                    ? 'Q'
                    : char.ToUpper(move.Promotion);

                if (promotion != 'Q' && promotion != 'R' &&
                    promotion != 'B' && promotion != 'N')
                {
                    throw new ArgumentException("Invalid promotion piece.");
                }

                gameState.Board[move.ToRow, move.ToCol] =
                    isWhiteMove
                        ? promotion
                        : char.ToLower(promotion);
            }

            // Update castling rights
            UpdateCastlingRights(
                gameState, move, piece, capturedPiece);

            // Update en passant target
            gameState.EnPassantSquare = null;

            if (char.ToUpper(piece) == 'P' &&
                Math.Abs(move.ToRow - move.FromRow) == 2)
            {
                int enPassantRow =
                    (move.FromRow + move.ToRow) / 2;

                gameState.EnPassantSquare =
                    $"{(char)('a' + move.FromCol)}{8 - enPassantRow}";
            }

            // Update half-move clock
            if (char.ToUpper(piece) == 'P' || capturedPiece != ' ')
                gameState.HalfMoveCLock = 0;
            else
                gameState.HalfMoveCLock++;

            // Full move number increments after Black's move
            if (!isWhiteMove)
                gameState.FullMoveNumber++;

            // Record move
            gameState.MoveHistory.Add(move);

            // Switch active player
            gameState.WhiteToMove = !isWhiteMove;
        }

        private void PerformCastling(GameState gameState, Move move)
        {
            int row = move.FromRow;

            if (move.ToCol > move.FromCol)
            {
                // Kingside: rook h-file to f-file
                gameState.Board[row, 5] = gameState.Board[row, 7];
                gameState.Board[row, 7] = ' ';
            }
            else
            {
                // Queenside: rook a-file to d-file
                gameState.Board[row, 3] = gameState.Board[row, 0];
                gameState.Board[row, 0] = ' ';
            }
        }

        private void UpdateCastlingRights(
            GameState gameState,
            Move move,
            char piece,
            char capturedPiece)
        {
            // White king moved
            if (piece == 'K')
            {
                gameState.WhiteCanCastleKingside = false;
                gameState.WhiteCanCastleQueenSide = false;
            }

            // Black king moved
            if (piece == 'k')
            {
                gameState.BlackCanCastleKingside = false;
                gameState.BlackCanCastleQueenSide = false;
            }

            // White rook moved
            if (piece == 'R')
            {
                if (move.FromRow == 7 && move.FromCol == 0)
                    gameState.WhiteCanCastleQueenSide = false;

                if (move.FromRow == 7 && move.FromCol == 7)
                    gameState.WhiteCanCastleKingside = false;
            }

            // Black rook moved
            if (piece == 'r')
            {
                if (move.FromRow == 0 && move.FromCol == 0)
                    gameState.BlackCanCastleQueenSide = false;

                if (move.FromRow == 0 && move.FromCol == 7)
                    gameState.BlackCanCastleKingside = false;
            }

            // White rook captured
            if (capturedPiece == 'R')
            {
                if (move.ToRow == 7 && move.ToCol == 0)
                    gameState.WhiteCanCastleQueenSide = false;

                if (move.ToRow == 7 && move.ToCol == 7)
                    gameState.WhiteCanCastleKingside = false;
            }

            // Black rook captured
            if (capturedPiece == 'r')
            {
                if (move.ToRow == 0 && move.ToCol == 0)
                    gameState.BlackCanCastleQueenSide = false;

                if (move.ToRow == 0 && move.ToCol == 7)
                    gameState.BlackCanCastleKingside = false;
            }
        }
    }
}
